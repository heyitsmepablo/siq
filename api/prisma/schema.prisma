generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model followUps {
  id                     Int                      @id @default(autoincrement())
  institute_id           Int?
  lastVisit              DateTime?                @db.Date
  createdAt              DateTime?                @default(now()) @db.Timestamp(6)
  updatedAt              DateTime?                @db.Timestamp(6)
  institutes             institutes?              @relation(fields: [institute_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  followUps_requirements followUps_requirements[]
}

model followUps_requirements {
  id             Int                 @id @default(autoincrement())
  followUp_id    Int?
  requirement_id Int?
  status         requirement_status?
  observation    String?
  completed      Boolean?            @default(false)
  createdAt      DateTime?           @default(now()) @db.Timestamp(6)
  updatedAt      DateTime?           @db.Timestamp(6)
  followUps      followUps?          @relation(fields: [followUp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requirements   requirements?       @relation(fields: [requirement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model institutes {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  createdAt DateTime?   @default(now()) @db.Timestamp(6)
  updatedAt DateTime?   @db.Timestamp(6)
  followUps followUps[]
}

model processes {
  id        Int        @id @default(autoincrement())
  name      String
  type      String
  createdAt DateTime?  @default(now()) @db.Timestamp(6)
  updatedAt DateTime?  @db.Timestamp(6)
  sections  sections[]
}

model requirements {
  id                     Int                      @id @default(autoincrement())
  subsection_id          Int?
  manualRequirement      String?
  description            String?
  level                  Int?
  evidence               String?
  createdAt              DateTime?                @default(now()) @db.Timestamp(6)
  updatedAt              DateTime?                @db.Timestamp(6)
  followUps_requirements followUps_requirements[]
  subsections            subsections?             @relation(fields: [subsection_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sections {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  process_id  Int?
  code        String?
  createdAt   DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime?     @db.Timestamp(6)
  processes   processes?    @relation(fields: [process_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subsections subsections[]
}

model subsections {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  section_id   Int?
  code         String?
  createdAt    DateTime?      @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?      @db.Timestamp(6)
  requirements requirements[]
  sections     sections?      @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String    @unique
  password        String
  accessToken     String?
  tokenExpiration DateTime? @db.Timestamp(6)
  lastLogin       DateTime? @db.Date
  createdAt       DateTime? @default(now()) @db.Timestamp(6)
  updatedAt       DateTime? @db.Timestamp(6)
}

enum requirement_status {
  satisfaz
  conforme
  parcialmente_conforme
  nao_conforme
  nao_aplica
}
